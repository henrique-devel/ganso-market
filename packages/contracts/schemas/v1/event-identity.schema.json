{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ganso-market:contracts:v1:event-identity",
  "title": "EventIdentity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "slot",
    "commitment",
    "source_timestamp",
    "received_at",
    "parser_version",
    "payload_hash"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "slot": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "commitment": {
      "type": "string",
      "enum": ["processed", "confirmed", "finalized"]
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "parser_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
