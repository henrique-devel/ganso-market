# O bind e fixo em 127.0.0.1 nesta RFC. Publicacao externa/TLS pertence a RFC-002.
GANSO_HTTP_PORT=8080

# Estes valores sao caminhos, nunca o conteudo de um segredo.
GANSO_CONFIG_FILE=/etc/ganso/runtime.json
GANSO_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Private key e seed nunca usam variavel de ambiente neste projeto.
