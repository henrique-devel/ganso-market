{
  "schema_version": 1,
  "execution_mode": "paper",
  "database": {
    "host": "postgres",
    "port": 5432,
    "name": "ganso_market",
    "user": "ganso_market",
    "connect_timeout_ms": 1000
  },
  "services": {
    "api": {
      "bind_address": "0.0.0.0",
      "port": 3000,
      "statement_timeout_ms": {
        "ceiling": 4000,
        "default": 2000,
        "routes": {
          "/trading/experiment-datasets": 1500,
          "/trading/experiments": 4000,
          "/trading/experiment-system": 1500,
          "/trading/accounts": 1500,
          "/trading/jev": 1500,
          "/trading/jev/metrics": 4000,
          "/trading/jev/benchmarks": 1500,
          "/trading/jev/results": 1500,
          "/trading/account": 1500,
          "/trading/positions": 1500,
          "/trading/orders": 1500,
          "/trading/operation": 1500
        }
      }
    }
  },
  "logging": {
    "level": "info"
  }
}
